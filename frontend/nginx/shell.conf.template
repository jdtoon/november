map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    set $bff_upstream ${BFF_UPSTREAM};
    set $payments_upstream ${PAYMENTS_UPSTREAM};
    set $approvals_upstream ${APPROVALS_UPSTREAM};
    set $incoming_upstream ${INCOMING_UPSTREAM};

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/static-files.conf;

    location /api/ {
        proxy_pass $bff_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location /remotes/payments/ {
        rewrite ^/remotes/payments/(.*)$ /$1 break;
        proxy_pass $payments_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location /remotes/approvals/ {
        rewrite ^/remotes/approvals/(.*)$ /$1 break;
        proxy_pass $approvals_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location /remotes/incoming/ {
        rewrite ^/remotes/incoming/(.*)$ /$1 break;
        proxy_pass $incoming_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
